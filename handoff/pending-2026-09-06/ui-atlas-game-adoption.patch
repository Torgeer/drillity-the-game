+    await turn();
+    for (const [id, fn] of [...records.frames]) { records.frames.delete(id); fn(); }
+    await turn();
+  };
+  return { records, view, doc, makeRoot, options, fontsReady, flush };
+}
+async function test(name, run) {
+  await run();
+  passed++;
+  console.log(`PASS ${name}`);
+}
+await test('configured deployment base, opt-in only, shared manifest/decode and idempotent mount', async () => {
+  const env = environment(), a = env.makeRoot(), b = env.makeRoot();
+  const { button } = a.addButton(); b.addButton();
+  const first = mountBlenderAtlas(a, { baseUrl: '/deployed/game/' });
+  const second = mountBlenderAtlas(b, { baseUrl: '/deployed/game/' });
+  assert.equal(mountBlenderAtlas(a), first);
+  assert.equal(first.refresh(), first.ready, 'same pending density must not cancel initial ready');
+  assert.equal(await first.ready, true); assert.equal(await second.ready, true);
+  assert.deepEqual(env.records.fetches, ['https://example.test/deployed/game/ui/blender/manifest.json']);
+  assert.deepEqual(env.records.imageUrls, ['https://example.test/deployed/game/ui/blender/ui-atlas.png']);
+  assert.equal(env.records.decodes, 1);
+  assert.equal(a.dataset.atlasReady, 'true'); assert.equal(a.dataset.atlasDensity, '1x');
+  assert.equal(button.style.getPropertyValue('--bui-native-width'), `${normal.native.width}px`);
+  assert.equal(button.style.getPropertyValue('--bui-foreground-normal'), normal.recommendedForeground);
+  assert.equal(button.classList.contains('bui-text-fit-fallback'), false);
+  first.dispose(); second.dispose();
+  assert.equal(a.getAttribute('data-blender-ui'), null); assert.equal(button.classList.contains('bui-button'), false);
+  assert.equal(button.classList.contains('btn'), true);
+});
+await test('safe area includes text ink, icon boxes, parent width and vertical enlargement', async () => {
+  const env = environment(), root = env.makeRoot(), { button, label, parent } = root.addButton();
+  const control = mountBlenderAtlas(root);
+  await control.ready;
+  label.inkWidth = normal.safeText.width + 1;
+  await control.refresh(); assert.equal(button.classList.contains('bui-text-fit-fallback'), true, 'icon/wrapper overflow');
+  label.inkWidth = 70; label.textWidth = normal.safeText.width + 1;
+  await control.refresh(); assert.equal(button.classList.contains('bui-text-fit-fallback'), true, 'glyph overflow');
+  label.textWidth = 60; label.textHeight = normal.safeText.height + 1;
+  await control.refresh(); assert.equal(button.classList.contains('bui-text-fit-fallback'), true, '200% text fixture');
+  label.textHeight = 16; parent.clientWidth = normal.native.width - 1;
+  await control.refresh(); assert.equal(button.classList.contains('bui-text-fit-fallback'), true, 'native face cannot shrink');
+  parent.clientWidth = normal.native.width;
+  await control.refresh(); assert.equal(button.classList.contains('bui-text-fit-fallback'), false);
+  control.dispose();
+});
+await test('font/resize/label observers remeasure and dispose releases every observer/listener/frame', async () => {
+  const env = environment(), root = env.makeRoot(), { button, label } = root.addButton();
+  const control = mountBlenderAtlas(root); await control.ready;
+  label.textWidth = normal.safeText.width * 2;
+  env.doc.fonts.emit('loadingdone'); await env.flush();
+  assert.equal(button.classList.contains('bui-text-fit-fallback'), true);
+  label.textWidth = 50;
+  env.records.observers.find((o) => o.nodes.has(root)).fn(); await env.flush();
+  assert.equal(button.classList.contains('bui-text-fit-fallback'), false);
+  env.view.emit('resize');
+  control.dispose();
+  assert.equal(env.records.frames.size, 0);
+  assert.ok(env.records.observers.every((o) => o.nodes.size === 0));
+  assert.equal(env.view.listenerCount() + env.view.visualViewport.listenerCount() + env.doc.fonts.listenerCount(), 0);
+  assert.ok(env.records.medias.every((m) => m.listenerCount() === 0));
+  assert.equal(await control.refresh(), false);
+  env.fontsReady.resolve(); await env.flush(); assert.equal(env.records.frames.size, 0);
+});
+await test('DPR transition decodes only selected sheet, reuses prior density, retains native CSS geometry', async () => {
+  const env = environment(), root = env.makeRoot(), { button } = root.addButton();
+  const control = mountBlenderAtlas(root); await control.ready;
+  const width = button.style.getPropertyValue('--bui-native-width');
+  env.view.devicePixelRatio = 2; env.records.medias.at(-1).emit('change'); await env.flush();
+  await control.refresh();
+  assert.equal(root.dataset.atlasDensity, '2x');
+  assert.equal(button.style.getPropertyValue('--bui-native-width'), width);
+  assert.equal(env.records.imageUrls.length, 2);
+  env.view.devicePixelRatio = 1; await control.refresh();
+  assert.equal(env.records.imageUrls.length, 2); assert.equal(root.dataset.atlasDensity, '1x');
+  control.dispose();
+});
+for (const [name, option] of [['HTTP failure', { httpStatus: 404 }], ['network failure', { fetchError: true }],
+  ['image failure', { imageError: true }], ['decode failure', { decodeError: true }], ['dimension mismatch', { badDimensions: true }]]) {
