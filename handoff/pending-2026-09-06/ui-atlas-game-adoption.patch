diff --git a/src/ui/blender-atlas.js b/src/ui/blender-atlas.js
new file mode 100644
--- /dev/null
+++ b/src/ui/blender-atlas.js
@@ -0,0 +1,300 @@
+/** Opt-in DOM consumer for the frozen Blender atlas. Geometry, safe regions and
+ * foregrounds come from the deployed manifest; CSS motion remains the generated
+ * Blender authority. One owner per root; dispose before removing that root.
+ */
+import './motion.css';
+import './blender-atlas.css';
+
+const mounts = new WeakMap();
+const preserved = new WeakMap();
+const manifests = new Map();
+const images = new Map();
+const selector = 'button[data-bui-button]';
+const ownClasses = ['bui-button', 'bui-button--compact', 'bui-button--accent', 'bui-text-fit-fallback'];
+const states = ['normal', 'pressed', 'disabled'];
+// Operational timeout, not an authored motion duration or physical claim.
+const LOAD_TIMEOUT = 10000;
+const assert = (condition, message) => { if (!condition) throw new Error(message); };
+const positive = (value) => Number.isInteger(value) && value > 0;
+const rect = (value) => value && Number.isInteger(value.x) && value.x >= 0
+  && Number.isInteger(value.y) && value.y >= 0 && positive(value.width) && positive(value.height);
+const contains = (outer, inner) => inner.x + inner.width <= outer.width && inner.y + inner.height <= outer.height;
+const spriteId = (size, variant, state = 'normal') => `button-${size === 'compact' ? 'compact-' : ''}${variant}${state === 'normal' ? '' : `-${state}`}`;
+
+function validateManifest(manifest) {
+  assert(manifest?.schemaVersion === 1 && Array.isArray(manifest.sprites) && manifest.sprites.length, 'Invalid atlas manifest');
+  const a1 = manifest.atlases?.['1x'], a2 = manifest.atlases?.['2x'];
+  for (const atlas of [a1, a2]) {
+    assert(atlas && /^[a-zA-Z0-9_-]+(?:@2x)?\.png$/.test(atlas.file), 'Invalid atlas filename');
+    assert(positive(atlas.width) && positive(atlas.height), 'Invalid atlas dimensions');
+  }
+  assert(a2.width === a1.width * 2 && a2.height === a1.height * 2, 'Invalid atlas density');
+  const sprites = new Map();
+  for (const sprite of manifest.sprites) {
+    assert(/^[a-z][a-z0-9-]*$/.test(sprite.id) && !sprites.has(sprite.id), 'Invalid or duplicate atlas sprite');
+    assert(positive(sprite.native?.width) && positive(sprite.native?.height) && rect(sprite.atlas), 'Invalid sprite dimensions');
+    assert(sprite.atlas.width === sprite.native.width && sprite.atlas.height === sprite.native.height && contains(a1, sprite.atlas), 'Sprite outside atlas');
+    for (const previous of sprites.values()) {
+      const a = previous.atlas, b = sprite.atlas;
+      assert(a.x + a.width <= b.x || b.x + b.width <= a.x || a.y + a.height <= b.y || b.y + b.height <= a.y, 'Overlapping atlas sprites');
+    }
+    sprites.set(sprite.id, sprite);
+  }
+  for (const size of ['standard', 'compact']) for (const variant of ['neutral', 'accent']) {
+    let normal;
+    for (const state of states) {
+      const sprite = sprites.get(spriteId(size, variant, state));
+      assert(sprite?.role === 'button' && sprite.state === state, 'Missing button state');
+      assert(sprite.native.width >= 44 && sprite.native.height >= 44, 'Button below project target floor');
+      assert(rect(sprite.safeText) && contains(sprite.native, sprite.safeText), 'Invalid button text-safe region');
+      assert(/^#[a-fA-F0-9]{6}$/.test(sprite.recommendedForeground), 'Invalid button foreground');
+      if (normal) assert(JSON.stringify(sprite.native) === JSON.stringify(normal.native)
+        && JSON.stringify(sprite.safeText) === JSON.stringify(normal.safeText), 'Button state geometry differs');
+      else normal = sprite;
+    }
+  }
+  return { manifest, sprites };
+}
+
+function singleflight(cache, key, create) {
+  if (!cache.has(key)) {
+    const pending = Promise.resolve().then(create);
+    cache.set(key, pending);
+    pending.catch(() => { if (cache.get(key) === pending) cache.delete(key); });
+  }
+  return cache.get(key);
+}
+
+function loadManifest(base, view) {
+  const url = new URL('manifest.json', base).href;
+  return singleflight(manifests, url, async () => {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), LOAD_TIMEOUT);
+    try {
+      const response = await view.fetch(url, { signal: controller.signal });
+      assert(response.ok, `Atlas manifest HTTP ${response.status}`);
+      return validateManifest(await response.json());
+    } finally { clearTimeout(timer); }
+  });
+}
+
+function loadImage(base, atlas, view) {
+  const url = new URL(atlas.file, base).href;
+  return singleflight(images, `${url}|${atlas.width}x${atlas.height}`, () => new Promise((resolve, reject) => {
+    const image = new view.Image();
+    let settled = false;
+    const finish = (error) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      image.onload = image.onerror = null;
+      if (error) { image.removeAttribute('src'); reject(error); }
+      else resolve({ url, image }); // Keep the decoded sheet reusable across menu/sheet mounts.
+    };
+    const timer = setTimeout(() => finish(new Error('Atlas image load timed out')), LOAD_TIMEOUT);
+    image.onerror = () => finish(new Error('Atlas image unavailable'));
+    image.onload = async () => {
+      try {
+        if (image.decode) await image.decode();
+        assert(image.naturalWidth === atlas.width && image.naturalHeight === atlas.height, 'Atlas decoded dimensions differ from manifest');
+        finish();
+      } catch (error) { finish(error); }
+    };
+    image.src = url;
+  }));
+}
+
+/** ready resolves false on asset failure/disposal; it never rejects. refresh is
+ * also an explicit retry after failure. Observer updates do not retry a broken
+ * asset on every DOM change. No handlers/ARIA/game state are replaced.
+ */
+export function mountBlenderAtlas(root, { baseUrl = import.meta.env?.BASE_URL ?? './' } = {}) {
+  assert(root?.ownerDocument?.defaultView && root.querySelectorAll, 'Atlas needs a DOM root');
+  if (mounts.has(root)) return mounts.get(root);
+  const doc = root.ownerDocument, view = doc.defaultView;
+  const base = new URL('ui/blender/', new URL(baseUrl, doc.baseURI));
+  const previous = preserved.get(root);
+  preserved.delete(root);
+  const originals = previous?.originals || new Map(), buttons = previous?.buttons || new Map(), watched = new Set();
+  let disposed = false, version = 0, frame = 0, loaded, density, densityMedia, controller, pending;
+  let requestedDensity;
+  const remember = (element, key, value, read, write) => {
+    let entries = originals.get(element);
+    if (!entries) originals.set(element, entries = new Map());
+    if (!entries.has(key)) entries.set(key, { value: read(), read, write });
+    entries.get(key).last = value;
+    if (read() !== value) write(value);
+  };
+  const attr = (element, name, value) => remember(element, name, value,
+    () => element.getAttribute(name), (next) => next === null ? element.removeAttribute(name) : element.setAttribute(name, next));
+  const style = (element, name, value) => remember(element, `style:${name}`, value,
+    () => element.style.getPropertyValue(name), (next) => next === '' ? element.style.removeProperty(name) : element.style.setProperty(name, next));
+  const restore = (element) => {
+    for (const { value, last, read, write } of originals.get(element)?.values() || []) if (read() === last) write(value);
+    originals.delete(element);
+    const classes = buttons.get(element);
+    if (classes) for (const [name, had] of classes) element.classList.toggle(name, had);
+    buttons.delete(element);
+  };
+  const observe = () => mutations?.observe(root, { subtree: true, childList: true, characterData: true, attributes: true,
+    attributeFilter: ['data-bui-button', 'data-bui-size', 'class', 'style', 'aria-pressed', 'disabled', 'hidden'] });
+  const ownWrite = (fn) => {
+    mutations?.disconnect();
+    try { fn(); } finally { if (!disposed) observe(); }
+  };
+  const resize = view.ResizeObserver ? new view.ResizeObserver(() => schedule()) : null;
+  const mutations = view.MutationObserver ? new view.MutationObserver((records) => {
+    // A menu also contains animated balance/statistics. Only opt-in controls,
+    // their ancestors and insertion/removal of opt-in controls can affect fit.
+    const related = (node) => node && (node.closest?.(selector) || node.querySelector?.(selector));
+    if (records.some((record) => {
+      const target = record.target.nodeType === 3 ? record.target.parentElement : record.target;
+      if (record.type === 'characterData') return !!target?.closest?.(selector);
+      if (related(target) || target === root && record.type === 'attributes') return true;
+      return [...(record.addedNodes || []), ...(record.removedNodes || [])].some(related);
+    })) schedule();
+  }) : null;
+
+  function fit() {
+    if (disposed) return;
+    ownWrite(() => {
+      const present = new Set(root.querySelectorAll(selector));
+      for (const button of buttons.keys()) if (!present.has(button)) restore(button);
+      const nextWatched = new Set([root]);
+      for (const button of present) {
+        if (!buttons.has(button)) buttons.set(button, ownClasses.map((name) => [name, button.classList.contains(name)]));
+        button.classList.add('bui-button');
+        const size = button.dataset.buiSize || 'standard', variant = button.dataset.buiButton;
+        button.classList.toggle('bui-button--compact', size === 'compact');
+        button.classList.toggle('bui-button--accent', variant === 'accent');
+        const label = [...button.children].find((child) => child.classList.contains('bui-button__label'));
+        nextWatched.add(button);
+        if (button.parentElement) nextWatched.add(button.parentElement);
+        if (label) nextWatched.add(label);
+        const sprite = loaded?.sprites.get(spriteId(size, variant));
+        const valid = sprite && ['standard', 'compact'].includes(size) && label
+          && button.children.length === 1 && [...(button.childNodes || button.children)]
+            .every((child) => child === label || !child.textContent?.trim());
+        button.classList.add('bui-text-fit-fallback');
+        if (!valid) continue;
+        const { native, safeText } = sprite;
+        for (const [name, value] of Object.entries({ width: native.width, height: native.height,
+          'safe-width': safeText.width, 'safe-height': safeText.height, 'pad-top': safeText.y,
+          'pad-right': native.width - safeText.x - safeText.width, 'pad-bottom': native.height - safeText.y - safeText.height, 'pad-left': safeText.x })) {
+          style(button, `--bui-native-${name}`, `${value}px`);
+        }
+        for (const state of states) style(button, `--bui-foreground-${state}`, loaded.sprites.get(spriteId(size, variant, state)).recommendedForeground);
+        if (!density || !button.isConnected || !button.getClientRects().length) continue;
+        button.classList.remove('bui-text-fit-fallback');
+        const range = doc.createRange();
+        range.selectNodeContents(label);
+        const text = range.getBoundingClientRect(), bounds = label.getBoundingClientRect(), box = button.getBoundingClientRect();
+        const parent = button.parentElement;
+        const parentStyle = parent && view.getComputedStyle(parent);
+        const available = parent ? parent.clientWidth - (parseFloat(parentStyle.paddingLeft) || 0) - (parseFloat(parentStyle.paddingRight) || 0) : native.width;
+        // Include the wrapper's icon boxes and gaps as well as glyph ink; a
+        // range alone can miss replaced SVG contents. Never shrink/crop art.
+        const fits = Math.max(text.width, bounds.width, label.scrollWidth) <= safeText.width + .01
+          && Math.max(text.height, bounds.height, label.scrollHeight) <= safeText.height + .01
+          && Math.abs(box.width - native.width) < .1 && Math.abs(box.height - native.height) < .1
+          && available >= native.width;
+        button.classList.toggle('bui-text-fit-fallback', !fits);
+      }
+      for (const node of watched) if (!nextWatched.has(node)) { resize?.unobserve(node); watched.delete(node); }
+      for (const node of nextWatched) if (!watched.has(node)) { resize?.observe(node); watched.add(node); }
+    });
+  }
+
+  function schedule() {
+    if (disposed || frame) return;
+    frame = view.requestAnimationFrame(() => {
+      frame = 0;
+      fit();
+      if (requestedDensity !== currentDensity()) void refresh();
+    });
+  }
+  const currentDensity = () => view.devicePixelRatio > 1 ? '2x' : '1x';
+  function watchDensity() {
+    densityMedia?.removeEventListener('change', densityChange);
+    densityMedia = view.matchMedia?.(`(resolution: ${view.devicePixelRatio || 1}dppx)`);
+    densityMedia?.addEventListener('change', densityChange);
+  }
+  function densityChange() { watchDensity(); schedule(); }
+
+  function refresh() {
+    if (disposed) return Promise.resolve(false);
+    const selected = currentDensity();
+    if (pending?.selected === selected) return pending.promise;
+    requestedDensity = selected;
+    const ticket = ++version;
+    const promise = update(selected, ticket).finally(() => { if (pending?.promise === promise) pending = undefined; });
+    pending = { selected, promise };
+    return promise;
+  }
+
+  async function update(selected, ticket) {
+    try {
+      const data = await loadManifest(base, view);
+      const sheet = await loadImage(base, data.manifest.atlases[selected], view);
+      if (disposed || ticket !== version) return false;
+      loaded = data;
+      density = selected;
+      ownWrite(() => {
+        const native = data.manifest.atlases['1x'];
+        style(root, '--bui-atlas-image', `url("${sheet.url}")`);
+        style(root, '--bui-atlas-size', `${native.width}px ${native.height}px`);
+        for (const sprite of data.sprites.values()) style(root, `--bui-${sprite.id}`, `${-sprite.atlas.x}px ${-sprite.atlas.y}px`);
+        attr(root, 'data-atlas-ready', 'true');
+        attr(root, 'data-atlas-density', selected);
+        attr(root, 'data-atlas-error', null);
+      });
+      fit();
+      return true;
+    } catch (error) {
+      if (disposed || ticket !== version) return false;
+      density = undefined;
+      ownWrite(() => {
+        attr(root, 'data-atlas-ready', 'false');
+        attr(root, 'data-atlas-density', null);
+        attr(root, 'data-atlas-error', error.message || 'Atlas unavailable');
+      });
+      fit();
+      return false;
+    }
+  }
+
+  function dispose({ preserveAppearance = false } = {}) {
+    if (disposed) return;
+    disposed = true;
+    version++;
+    view.cancelAnimationFrame(frame);
+    resize?.disconnect();
+    mutations?.disconnect();
+    densityMedia?.removeEventListener('change', densityChange);
+    view.removeEventListener('resize', schedule);
+    view.visualViewport?.removeEventListener('resize', schedule);
+    doc.fonts?.removeEventListener('loadingdone', schedule);
+    // Screens/sheets start their exit animation before DOM removal. Their owner
+    // may freeze the current decoration while releasing every active observer.
+    if (preserveAppearance) preserved.set(root, { originals, buttons });
+    else {
+      for (const element of [...originals.keys(), ...buttons.keys()]) restore(element);
+      originals.clear();
+      buttons.clear();
+    }
+    watched.clear();
+    mounts.delete(root);
+  }
+
+  attr(root, 'data-blender-ui', '');
+  attr(root, 'data-atlas-ready', 'false');
+  fit();
+  view.addEventListener('resize', schedule);
+  view.visualViewport?.addEventListener('resize', schedule);
+  doc.fonts?.addEventListener('loadingdone', schedule);
+  doc.fonts?.ready.then(schedule, () => {});
+  watchDensity();
+  controller = { ready: refresh(), refresh, dispose };
+  mounts.set(root, controller);
+  return controller;
+}
