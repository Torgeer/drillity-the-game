+#!/usr/bin/env node
+/** CPU lifecycle/resource-contract probes. Synthetic DOM measurements are NOT
+ * SOURCED layout evidence: the separate real-menu browser review owns that.
+ * No browser/GPU, package install, asset edit or build wiring is required.
+ */
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = readFileSync(new URL('../src/ui/blender-atlas.js', import.meta.url), 'utf8');
+assert.match(source, /import '\.\/motion\.css'/);
+assert.match(source, /import '\.\/blender-atlas\.css'/);
+const { mountBlenderAtlas } = await import(`data:text/javascript;base64,${Buffer.from(source.replace(/^import '\.\/[^']+\.css';\r?\n/gm, '')).toString('base64')}`);
+const manifest = JSON.parse(readFileSync(new URL('../public/ui/blender/manifest.json', import.meta.url), 'utf8'));
+const normal = manifest.sprites.find((sprite) => sprite.id === 'button-neutral');
+const deferred = () => { let resolve, reject; const promise = new Promise((yes, no) => { resolve = yes; reject = no; }); return { promise, resolve, reject }; };
+let serial = 0, passed = 0;
+const turn = async () => { for (let i = 0; i < 12; i++) await Promise.resolve(); };
+function events(target = {}) {
+  const listeners = new Map();
+  return Object.assign(target, {
+    addEventListener(type, fn) { if (!listeners.has(type)) listeners.set(type, new Set()); listeners.get(type).add(fn); },
+    removeEventListener(type, fn) { listeners.get(type)?.delete(fn); },
+    emit(type) { for (const fn of listeners.get(type) || []) fn(); },
+    listenerCount() { return [...listeners.values()].reduce((count, set) => count + set.size, 0); },
+  });
+}
+function environment(options = {}) {
+  const records = { fetches: [], imageUrls: [], decodes: 0, observers: [], medias: [], frames: new Map() };
+  let frameId = 0;
+  const view = events({ devicePixelRatio: 1 });
+  view.visualViewport = events();
+  view.requestAnimationFrame = (fn) => { records.frames.set(++frameId, fn); return frameId; };
+  view.cancelAnimationFrame = (id) => records.frames.delete(id);
+  view.getComputedStyle = () => ({ paddingLeft: '0px', paddingRight: '0px' });
+  view.matchMedia = () => { const media = events(); records.medias.push(media); return media; };
