+#!/usr/bin/env node
+/** Actual-game menu adoption smoke. Run against a served integration checkout
+ * with its matching GLBs. This does not start a server or measure FPS.
+ * node tools/check-ui-atlas-game-smoke.mjs --url http://127.0.0.1:5178/ --lease root-integration
+ */
+import assert from 'node:assert/strict';
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { chromium } from 'playwright';
+
+const args = process.argv.slice(2);
+function option(name, fallback) {
+  const i = args.indexOf(name);
+  if (i < 0) return fallback;
+  assert.ok(args[i + 1] && !args[i + 1].startsWith('--'), `Missing ${name} value`);
+  return args[i + 1];
+}
+const lease = option('--lease', 'ui-atlas-adoption');
+const leaseFile = option('--lease-file', 'C:/Users/henri/Downloads/threads/drillity-coordination/gpu-owner.txt');
+const url = new URL(option('--url', 'http://127.0.0.1:5178/'));
+url.searchParams.set('quality', 'low');
+url.searchParams.set('shot', '');
+url.searchParams.set('glb', 'strict');
+const out = resolve(option('--out', 'shots/ui-atlas-game-smoke'));
+const report = { passed: false, scope: 'Actual game menu/preferences integration smoke; no FPS, AAA or general accessibility verdict', url: url.href, lease, cases: [], errors: [], warnings: [], atlasResponses: [], browserClosed: false };
+async function checkLease() { assert.equal((await readFile(leaseFile, 'utf8')).trim(), lease, 'Explicit GPU lease required'); }
+await checkLease();
+await mkdir(out, { recursive: true });
