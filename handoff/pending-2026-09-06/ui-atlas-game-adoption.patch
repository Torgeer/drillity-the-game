+// Actual production shell, screens, components, content and styles. No renderer,
+// simulation or GLB loader is instantiated: this is explicitly menu DOM evidence.
+import { createUI } from '../../src/ui/shell.js';
+import { createGameState, createBus, EVENTS } from '../../src/core/contract.js';
+import * as game from '../../src/game/data.js';
+import { mountBlenderAtlas } from '../../src/ui/blender-atlas.js';
+
+async function start() {
+const observed = { ResizeObserver: new Map(), MutationObserver: new Map() };
+for (const kind of Object.keys(observed)) {
+  const Native = window[kind];
+  window[kind] = class extends Native {
+    constructor(callback) { super(callback); observed[kind].set(this, new Set()); }
+    observe(target, options) { observed[kind].get(this).add(target); return super.observe(target, options); }
+    unobserve(target) { observed[kind].get(this).delete(target); return super.unobserve(target); }
+    disconnect() { observed[kind].get(this).clear(); return super.disconnect(); }
+  };
+}
+function observerCounts() { return Object.fromEntries(Object.entries(observed).map(([kind,instances]) => [kind,[...instances.values()].filter(targets=>targets.size).length])); }
+const state = createGameState();
+const bus = createBus();
+const events = [];
+for (const kind of [EVENTS.SCENE_CHANGE, EVENTS.QUALITY_CHANGE, EVENTS.HAPTIC]) {
+  bus.on(kind, value => events.push({ kind, value }));
+}
+const ctx = { uiRoot: document.querySelector('#ui'), state, bus, game };
+let ui = createUI(ctx);
+await ui.init();
+ui.setLoadingProgress(1);
+ui.update(1);
+ui.show('menu');
+function resize() { ui.resize(innerWidth, innerHeight, devicePixelRatio); }
+window.addEventListener('resize', resize);
+resize();
+let running = true;
+let previous = performance.now();
+function tick(now) {
+  if (!running) return;
+  ui.update(Math.min(.1, (now - previous) / 1000));
+  previous = now;
+  requestAnimationFrame(tick);
+}
+requestAnimationFrame(tick);
+let probe = null;
+let probeConsumer = null;
+const tokenStyle = getComputedStyle(document.documentElement);
+const originalTextTokens = new Map([...tokenStyle].filter(name => /^--t-/.test(name)).map(name => [name, tokenStyle.getPropertyValue(name).trim()]));
+const controlType = new WeakMap();
+window.review = {
+  state, events,
+  observerCounts,
+  get ui() { return ui; },
+  show(scene) { ui.show(scene); },
+  playState(kind) {
+    state.drill.active = kind === 'resume';
+    state.contract = kind === 'continue' ? { id: 'review-existing-contract' } : null;
+    ui.show('menu');
+  },
+  textScale(multiplier) {
+    // Snapshot the actual consumer sizes before changing the game's type tokens.
+    // This is a text enlargement exercise, not CSS/page zoom or a second scale.
+    for (const button of document.querySelectorAll('[data-bui-button]')) {
+      if (!controlType.has(button)) {
+        const computed = getComputedStyle(button);
+        controlType.set(button, {fontSize:parseFloat(computed.fontSize),lineHeight:parseFloat(computed.lineHeight)});
+      }
+    }
+    for (const [name, original] of originalTextTokens) {
+      if (!/^\d+(?:\.\d+)?px$/.test(original)) throw Error('Review requires a resolved pixel type token: ' + name);
+      document.documentElement.style.setProperty(name, parseFloat(original) * multiplier + 'px');
+    }
+    for (const button of document.querySelectorAll('[data-bui-button]')) {
+      const original = controlType.get(button);
+      button.style.fontSize = original.fontSize * multiplier + 'px';
+      if (Number.isFinite(original.lineHeight)) button.style.lineHeight = original.lineHeight * multiplier + 'px';
+    }
+    resize();
+  },
+  async recreate() {
+    ui.dispose();
+    ui = createUI(ctx);
+    await ui.init(); ui.setLoadingProgress(1); ui.update(1); ui.show('menu'); resize();
+  },
+  async mountProbe(options = {}) {
+    this.disposeProbe();
+    probe = document.createElement('div');
+    probe.id = 'review-probe'; probe.style.cssText = 'position:fixed;inset:60px 16px auto;z-index:1000;display:flex;flex-wrap:wrap;gap:12px;background:#0d1219;padding:20px;';
+    for (const [text, size] of [['Fit', 'compact'], ['Disabled', 'standard'], ['A deliberately long dynamic gameplay label', 'standard']]) {
+      const button = document.createElement('button'); button.type = 'button';
+      button.dataset.buiButton = 'neutral'; button.dataset.buiSize = size;
+      const label = document.createElement('span'); label.className = 'bui-button__label'; label.textContent = text; button.append(label);
+      if (text === 'Disabled') button.disabled = true;
+      probe.append(button);
+    }
+    document.body.append(probe);
+    probeConsumer = mountBlenderAtlas(probe, options);
+    return probeConsumer.ready;
+  },
+  refreshProbe() { return probeConsumer?.refresh(); },
+  disposeProbe() { probeConsumer?.dispose(); probeConsumer = null; probe?.remove(); probe = null; },
+  shutdown() { this.disposeProbe(); running = false; window.removeEventListener('resize', resize); ui.dispose(); },
+};
+}
+start().catch(error => { console.error(error); window.reviewError = error.stack; });
