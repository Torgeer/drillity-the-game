+});
+await test('unrelated menu statistics mutations do not schedule control measurements', async () => {
+  const env = environment(), root = env.makeRoot(); root.addButton();
+  const control = mountBlenderAtlas(root); await control.ready;
+  const mutation = env.records.observers[1];
+  mutation.fn([{ type: 'characterData', target: { nodeType: 3, parentElement: { closest: () => null } } }]);
+  assert.equal(env.records.frames.size, 0);
+  mutation.fn([{ type: 'characterData', target: { nodeType: 3, parentElement: { closest: () => root.controls[0] } } }]);
+  assert.equal(env.records.frames.size, 1);
+  await env.flush(); control.dispose();
+});
+await test('removal restores owned styles and invalid label markup remains flat', async () => {
+  const env = environment(), root = env.makeRoot(), { button } = root.addButton();
+  const control = mountBlenderAtlas(root); await control.ready;
+  button.childNodes = [...button.children, { textContent: 'Outside label' }];
+  await control.refresh(); assert.equal(button.classList.contains('bui-text-fit-fallback'), true, 'unmeasured visible text cannot use art');
+  button.children = []; await control.refresh(); assert.equal(button.classList.contains('bui-text-fit-fallback'), true);
+  root.controls = []; await control.refresh(); assert.equal(button.classList.contains('bui-button'), false);
+  assert.equal(button.style.getPropertyValue('--bui-native-width'), '');
+  control.dispose();
+});
+console.log(`Blender atlas consumer CPU PASS: ${passed} cases. Synthetic geometry only; no rendered-layout claim.`);
