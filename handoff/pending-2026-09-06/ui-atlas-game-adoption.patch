+    set src(url) {
+      records.imageUrls.push(url);
+      const atlas = (options.manifest || manifest).atlases[url.includes('@2x') ? '2x' : '1x'];
+      this.naturalWidth = options.badDimensions ? atlas.width + 1 : atlas.width;
+      this.naturalHeight = atlas.height;
