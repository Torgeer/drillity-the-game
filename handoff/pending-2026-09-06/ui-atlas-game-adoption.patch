+    records.fetches.push(url);
+    if (options.fetchWait) await options.fetchWait.promise;
+    if (options.fetchError) throw new Error('offline');
+    return { ok: options.httpStatus === undefined, status: options.httpStatus || 200,
+      json: async () => structuredClone(options.manifest || manifest) };
+  };
