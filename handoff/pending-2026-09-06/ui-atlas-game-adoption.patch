+/* Menu-only layout for opt-in Blender faces. The manifest and atlas consumer
+ * own native art dimensions; these gaps are authored UI spacing, NOT SOURCED
+ * machine dimensions. A separate grid slot makes available width measurable. */
+.menu .menu__nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.menu__atlas-slot,
+.menu-preferences__quality-slot {
+  display: flex;
+  align-items: flex-start;
+  justify-content: center;
+  min-width: 0;
+}
+.menu__atlas-slot .bui-text-fit-fallback,
+.menu-preferences__quality-slot .bui-text-fit-fallback { width: 100%; }
+
+/* Four compact faces use two rows so every native target fits on narrow
+ * phones, and the measured text fallback can grow without hiding a label. */
+.menu-preferences .menu-preferences__quality {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--s-2);
+  margin: var(--s-2) 0 0;
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  background: none;
+}
+.menu-preferences__quality [aria-pressed='true'] .bui-button__label {
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 3px;
+}
