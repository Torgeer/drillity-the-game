+    }
+    async decode() { records.decodes++; if (options.imageWait) await options.imageWait.promise; if (options.decodeError) throw new Error('decode failed'); }
+    removeAttribute() {}
+  };
+  const fontsReady = deferred();
+  const doc = { defaultView: view, baseURI: `https://example.test/probe-${++serial}/nested/route`,
+    fonts: events({ ready: fontsReady.promise }),
+    createRange() { let label; return { selectNodeContents(node) { label = node; }, getBoundingClientRect() { return { width: label.textWidth, height: label.textHeight }; } }; } };
+  class Element {
+    constructor(classes = []) {
+      this.ownerDocument = doc; this.attrs = new Map(); this.children = []; this.isConnected = true;
