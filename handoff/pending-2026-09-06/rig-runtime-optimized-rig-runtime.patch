+/** Private dev server for the frozen eight-case runtime measurement only.
+ * No production edits or dependency cache writes. Ctrl-C closes owned server.
+ */
+import { createServer } from 'vite';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+const root=resolve(dirname(fileURLToPath(import.meta.url)),'..'),work=resolve(root,'.optimized-rig-runtime');
+const lease=resolve(root,'../drillity-coordination/gpu-owner.txt');
+if(readFileSync(lease,'utf8').trim()!=='optimized-rig-runtime')throw Error('Exact optimized-rig-runtime GPU lease required');
+const server=await createServer({root:resolve(work,'frozen'),configFile:false,base:'./',cacheDir:resolve(work,'vite-cache'),server:{host:'127.0.0.1',port:5208,strictPort:true,watch:{ignored:['**/*']}}});
+await server.listen();
+writeFileSync(resolve(work,'server.json'),JSON.stringify({pid:process.pid,port:5208,root:resolve(work,'frozen'),started:new Date().toISOString()},null,2));
+console.log(`OWNED frozen Vite pid=${process.pid} port=5208`);
+for(const sig of ['SIGINT','SIGTERM'])process.on(sig,async()=>{await server.close();writeFileSync(resolve(work,'server-closed.json'),JSON.stringify({pid:process.pid,closed:new Date().toISOString()}));process.exit(0);});
