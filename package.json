{
  "name": "drillity-the-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5178",
    "build": "npm run check && vite build",
    "preview": "vite preview --host --port 5179",
    "check:facts": "node tools/checkfacts.mjs",
    "check:data": "node tools/checkdata.mjs",
    "check:beds": "node tools/checkbeds.mjs",
    "check": "node tools/checkfacts.mjs && node tools/checkdata.mjs && node tools/checkbeds.mjs && node tools/checkmodels.mjs && node tools/checkhaptics.mjs && node tools/checkreach.mjs",
    "blender": "\"C:/Program Files/Blender Foundation/Blender 5.2/blender.exe\" --background --python blender/build.py --",
    "check:reach": "node tools/checkreach.mjs",
    "models:pack": "node tools/glbpack.mjs",
    "models:check": "node tools/glbpack.mjs --check",
    "check:models": "node tools/checkmodels.mjs",
    "check:haptics": "node tools/checkhaptics.mjs"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "playwright": "^1.49.1",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
